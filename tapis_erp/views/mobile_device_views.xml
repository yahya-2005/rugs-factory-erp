<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_device_tree" model="ir.ui.view">
        <field name="name">tapis.mobile.device.tree</field>
        <field name="model">tapis.mobile.device</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="last_sync_datetime"/>
                <field name="last_login_datetime"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_mobile_device_form" model="ir.ui.view">
        <field name="name">tapis.mobile.device.form</field>
        <field name="model">tapis.mobile.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="device_uuid"/>
                            <field name="platform"/>
                            <field name="app_version"/>
                        </group>
                        <group>
                            <field name="push_token"/>
                            <field name="last_sync_datetime"/>
                            <field name="last_login_datetime"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sync Logs">
                            <field name="sync_log_ids">
                                <tree>
                                    <field name="sync_start_datetime"/>
                                    <field name="sync_end_datetime"/>
                                    <field name="duration_seconds"/>
                                    <field name="records_downloaded"/>
                                    <field name="records_uploaded"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tapis_mobile_device" model="ir.actions.act_window">
        <field name="name">Mobile Devices</field>
        <field name="res_model">tapis.mobile.device</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
