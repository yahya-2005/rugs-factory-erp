<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_users_signature_form" model="ir.ui.view">
            <field name="name">res.users.signature.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <field name="signature" position="after">
                    <field name="default_signature_image" widget="signature" string="Default Signature Image"/>
                    <field name="signature_title" placeholder="e.g. Managing Director"/>
                </field>
            </field>
        </record>

        <record id="view_res_users_security_form" model="ir.ui.view">
            <field name="name">res.users.security.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <separator string="Access Control" colspan="4"/>
                    <group>
                        <group>
                            <field name="security_department_id"/>
                            <field name="employee_level"/>
                        </group>
                        <group>
                            <field name="data_access_scope"/>
                            <field name="can_view_financial_data"/>
                            <field name="can_export_sensitive_data"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
