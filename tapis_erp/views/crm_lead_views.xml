<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

<!-- KANBAN VIEW (Pipeline) -->
<record id="view_tapis_crm_lead_kanban" model="ir.ui.view">
    <field name="name">tapis.crm.lead.kanban</field>
    <field name="model">tapis.crm.lead</field>
    <field name="arch" type="xml">
        <kanban string="Sales Pipeline" default_group_by="stage_id" class="o_kanban_mobile">
            <field name="color"/>
            <field name="name"/>
            <field name="contact_name"/>
            <field name="expected_revenue"/>
            <field name="weighted_revenue"/>
            <field name="priority"/>
            <field name="expected_closing_date"/>
            <field name="tag_ids"/>
            <field name="stage_id"/>
            <field name="color"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-raw="record.name.raw_value"/>
                                    </strong>
                                    <t t-if="record.contact_name.raw_value">
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <t t-raw="record.contact_name.raw_value"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div class="oe_kanban_actions">
                                <t t-if="record.priority.raw_value == 'urgent'">
                                    <i class="fa fa-exclamation-triangle text-danger" title="Urgent"/>
                                </t>
                                <t t-if="record.priority.raw_value == 'high'">
                                    <i class="fa fa-exclamation-circle text-warning" title="High"/>
                                </t>
                                <t t-if="record.priority.raw_value == 'low'">
                                    <i class="fa fa-arrow-down text-success" title="Low"/>
                                </t>
                            </div>
                        </div>
                        <div class="o_kanban_card_content">
                            <t t-if="record.tag_ids.raw_value">
                                <div class="o_kanban_tags">
                                    <t t-foreach="record.tag_ids.raw_value" t-as="tag">
                                        <span class="badge" t-attf-style="background-color: #{kanban_getcolor(tag[2])}; color: white; margin: 1px;">
                                            <t t-esc="tag[1]"/>
                                        </span>
                                    </t>
                                </div>
                            </t>
                            <div class="mt8">
                                <t t-if="record.expected_revenue.raw_value">
                                    <span class="text-info">
                                        <i class="fa fa-money"/> Expected: <t t-esc="record.expected_revenue.raw_value"/> MAD
                                    </span>
                                </t>
                                <t t-if="record.weighted_revenue.raw_value">
                                    <br/>
                                    <span class="text-success">
                                        Weighted: <t t-esc="record.weighted_revenue.raw_value"/> MAD
                                    </span>
                                </t>
                                <t t-if="record.expected_closing_date.raw_value">
                                    <br/>
                                    <span>
                                        <i class="fa fa-calendar"/> Close: <t t-esc="record.expected_closing_date.raw_value"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<!-- TREE VIEW -->
<record id="view_tapis_crm_lead_tree" model="ir.ui.view">
    <field name="name">tapis.crm.lead.tree</field>
    <field name="model">tapis.crm.lead</field>
    <field name="arch" type="xml">
        <tree string="Opportunities" decoration-danger="priority=='urgent' and state=='open'" decoration-warning="priority=='high' and state=='open'" decoration-success="state=='won'" decoration-muted="state=='lost'">
            <field name="code"/>
            <field name="name"/>
            <field name="contact_name"/>
            <field name="stage_id"/>
            <field name="salesperson_id"/>
            <field name="expected_revenue"/>
            <field name="probability" widget="progressbar"/>
            <field name="weighted_revenue" sum="Total Weighted"/>
            <field name="priority"/>
            <field name="expected_closing_date"/>
            <field name="state"/>
        </tree>
    </field>
</record>

<!-- FORM VIEW -->
<record id="view_tapis_crm_lead_form" model="ir.ui.view">
    <field name="name">tapis.crm.lead.form</field>
    <field name="model">tapis.crm.lead</field>
    <field name="arch" type="xml">
        <form string="Opportunity">
            <header>
                <button name="action_mark_won" type="object" string="Mark Won" states="open" class="btn-success"/>
                <button name="action_mark_lost" type="object" string="Mark Lost" states="open" class="btn-danger"/>
                <button name="action_reset_open" type="object" string="Reset to Open" states="won,lost" class="btn-warning"/>
                <button name="action_convert_to_customer" type="object" string="Convert to Customer" states="open" class="btn-info"/>
                <button name="action_create_sale" type="object" string="Create Sale Order" states="open,won" class="btn-primary"/>
                <field name="state" widget="statusbar" statusbar_visible="open,won,lost" clickable="True"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" placeholder="Opportunity name..."/></h1>
                    <group>
                        <field name="code"/>
                        <field name="stage_id" widget="statusbar" statusbar_visible="True"/>
                    </group>
                </div>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_opportunities" type="object" class="oe_stat_button" icon="fa-usd">
                        <div class="o_stat_info">
                            <field name="expected_revenue" widget="statinfo"/>
                            <span class="o_stat_text">Expected Revenue</span>
                        </div>
                    </button>
                </div>
                <notebook>
                    <page string="Opportunity Details">
                        <group>
                            <group string="Contact Info">
                                <field name="contact_name"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="company_name"/>
                                <field name="address"/>
                            </group>
                            <group string="Sales Info">
                                <field name="customer_id" options="{'no_create': True}"/>
                                <field name="salesperson_id" options="{'no_create': True}"/>
                                <field name="source"/>
                                <field name="priority"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Forecast">
                            <field name="expected_revenue"/>
                            <field name="probability" widget="progressbar"/>
                            <field name="weighted_revenue"/>
                            <field name="expected_closing_date"/>
                        </group>
                        <group string="Related">
                            <field name="related_sale_id"/>
                        </group>
                        <field name="description" nolabel="1"/>
                    </page>
                    <page string="Notes">
                        <field name="note" nolabel="1"/>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
    </field>
</record>

<!-- SEARCH VIEW -->
<record id="view_tapis_crm_lead_search" model="ir.ui.view">
    <field name="name">tapis.crm.lead.search</field>
    <field name="model">tapis.crm.lead</field>
    <field name="arch" type="xml">
        <search string="Search Opportunities">
            <field name="name"/>
            <field name="contact_name"/>
            <field name="company_name"/>
            <field name="email"/>
            <field name="tag_ids"/>
            <filter name="open" string="Open" domain="[('state','=','open')]"/>
            <filter name="won" string="Won" domain="[('state','=','won')]"/>
            <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
            <filter name="my_opportunities" string="My Opportunities" domain="[('salesperson_id','=',uid)]"/>
            <filter name="closing_this_month" string="Closing This Month" help="Opportunities closing this month" context="{'group_by':'expected_closing_date:month'}"/>
            <group expand="0" string="Group By">
                <filter name="g_stage" string="Stage" context="{'group_by':'stage_id'}"/>
                <filter name="g_salesperson" string="Salesperson" context="{'group_by':'salesperson_id'}"/>
                <filter name="g_priority" string="Priority" context="{'group_by':'priority'}"/>
                <filter name="g_source" string="Source" context="{'group_by':'source'}"/>
            </group>
        </search>
    </field>
</record>

<!-- ACTION -->
<record id="action_tapis_crm_lead" model="ir.actions.act_window">
    <field name="name">CRM Pipeline</field>
    <field name="res_model">tapis.crm.lead</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{'search_default_open': 1}</field>
</record>

</data></odoo>
