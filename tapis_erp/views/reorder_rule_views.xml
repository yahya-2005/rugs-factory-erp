<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_reorder_rule_tree" model="ir.ui.view">
            <field name="name">tapis.reorder.rule.tree</field>
            <field name="model">tapis.reorder.rule</field>
            <field name="arch" type="xml">
                <tree string="Reorder Rules"
                    decoration-danger="state == 'to_order'"
                    decoration-success="state == 'ok'">
                    <field name="product_id"/>
                    <field name="warehouse_id"/>
                    <field name="current_qty"/>
                    <field name="min_qty"/>
                    <field name="max_qty"/>
                    <field name="qty_to_order"/>
                    <field name="supplier_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_reorder_rule_form" model="ir.ui.view">
            <field name="name">tapis.reorder.rule.form</field>
            <field name="model">tapis.reorder.rule</field>
            <field name="arch" type="xml">
                <form string="Reorder Rule">
                    <header>
                        <button name="action_create_purchase" type="object" string="Create Purchase Order" states="to_order" class="btn-primary"/>
                        <field name="state" widget="statusbar" statusbar_visible="ok,to_order"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="min_qty"/>
                            <field name="max_qty"/>
                            <field name="current_qty"/>
                            <field name="qty_to_order"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_reorder_rule_search" model="ir.ui.view">
            <field name="name">tapis.reorder.rule.search</field>
            <field name="model">tapis.reorder.rule</field>
            <field name="arch" type="xml">
                <search string="Search Reorder Rules">
                    <field name="product_id"/>
                    <field name="warehouse_id"/>
                    <field name="supplier_id"/>
                    <filter name="filter_to_order" string="Needs Reordering" domain="[('state','=','to_order')]"/>
                    <filter name="filter_ok" string="OK" domain="[('state','=','ok')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
                        <filter name="group_by_supplier" string="Supplier" context="{'group_by':'supplier_id'}"/>
                        <filter name="group_by_product" string="Product" context="{'group_by':'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_reorder_rule" model="ir.actions.act_window">
            <field name="name">Reorder Rules</field>
            <field name="res_model">tapis.reorder.rule</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_reorder_rule_search"/>
        </record>

    </data>
</odoo>
