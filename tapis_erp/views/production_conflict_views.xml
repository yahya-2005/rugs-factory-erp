<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_production_conflict_tree" model="ir.ui.view">
            <field name="name">tapis.production.conflict.tree</field>
            <field name="model">tapis.production.conflict</field>
            <field name="arch" type="xml">
                <tree string="Production Conflicts" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'">
                    <field name="production_id"/>
                    <field name="conflicting_production_id"/>
                    <field name="resource_id"/>
                    <field name="overlap_start"/>
                    <field name="overlap_end"/>
                    <field name="severity"/>
                </tree>
            </field>
        </record>

        <record id="view_production_conflict_form" model="ir.ui.view">
            <field name="name">tapis.production.conflict.form</field>
            <field name="model">tapis.production.conflict</field>
            <field name="arch" type="xml">
                <form string="Production Conflict">
                    <group>
                        <field name="production_id"/>
                        <field name="conflicting_production_id"/>
                        <field name="resource_id"/>
                        <field name="overlap_start"/>
                        <field name="overlap_end"/>
                        <field name="severity"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_production_conflict_search" model="ir.ui.view">
            <field name="name">tapis.production.conflict.search</field>
            <field name="model">tapis.production.conflict</field>
            <field name="arch" type="xml">
                <search string="Search Conflicts">
                    <field name="production_id"/>
                    <field name="resource_id"/>
                    <filter name="critical" string="Critical" domain="[('severity','=','critical')]"/>
                </search>
            </field>
        </record>

        <record id="action_production_conflict" model="ir.actions.act_window">
            <field name="name">Production Conflicts</field>
            <field name="res_model">tapis.production.conflict</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_production_conflict_search"/>
        </record>
    </data>
</odoo>
