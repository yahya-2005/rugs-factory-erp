<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bom_tree" model="ir.ui.view">
            <field name="name">tapis.bom.tree</field>
            <field name="model">tapis.bom</field>
            <field name="arch" type="xml">
                <tree string="Bills of Materials">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="version"/>
                    <field name="total_material_cost" sum="Total Material Cost"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_bom_form" model="ir.ui.view">
            <field name="name">tapis.bom.form</field>
            <field name="model">tapis.bom</field>
            <field name="arch" type="xml">
                <form string="Bill of Materials">
                    <header>
                        <button name="%(action_report_bom)d" type="action" string="Print BOM" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="version"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="total_material_cost"/>
                            <field name="note"/>
                        </group>
                        <notebook>
                            <page string="Materials">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="raw_material_id"/>
                                        <field name="quantity"/>
                                        <field name="unit_cost"/>
                                        <field name="line_cost"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_bom_search" model="ir.ui.view">
            <field name="name">tapis.bom.search</field>
            <field name="model">tapis.bom</field>
            <field name="arch" type="xml">
                <search string="Search BOMs">
                    <field name="name"/>
                    <field name="product_id"/>
                    <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_product" string="Product" context="{'group_by':'product_id'}"/>
                        <filter name="group_by_version" string="Version" context="{'group_by':'version'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_bom" model="ir.actions.act_window">
            <field name="name">Bills of Materials</field>
            <field name="res_model">tapis.bom</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_bom_search"/>
        </record>
    </data>
</odoo>
