<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_tapis_profitability_analysis_tree" model="ir.ui.view">
            <field name="name">tapis.profitability.analysis.tree</field>
            <field name="model">tapis.profitability.analysis</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="analysis_type"/>
                    <field name="product_id"/>
                    <field name="customer_id"/>
                    <field name="revenue"/>
                    <field name="total_cost"/>
                    <field name="gross_profit"/>
                    <field name="gross_margin_percent" string="Margin %"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_tapis_profitability_analysis_form" model="ir.ui.view">
            <field name="name">tapis.profitability.analysis.form</field>
            <field name="model">tapis.profitability.analysis</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_calculate" type="object"
                            string="Calculate" class="btn-primary"
                            states="draft"/>
                        <button name="action_approve" type="object"
                            string="Approve" class="btn-success"
                            states="calculated"/>
                        <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            states="calculated,approved"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Analysis Scope">
                                <field name="analysis_type"/>
                                <field name="product_id"
                                    attrs="{'invisible': [('analysis_type', 'not in', ('product',))], 'required': [('analysis_type', '=', 'product')]}"/>
                                <field name="customer_id"
                                    attrs="{'invisible': [('analysis_type', '!=', 'customer')], 'required': [('analysis_type', '=', 'customer')]}"/>
                                <field name="project_id"
                                    attrs="{'invisible': [('analysis_type', '!=', 'project')], 'required': [('analysis_type', '=', 'project')]}"/>
                            </group>
                            <group string="Period">
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Cost Breakdown">
                                <group>
                                    <group string="Revenue &amp; Costs">
                                        <field name="revenue"/>
                                        <field name="material_cost"/>
                                        <field name="labor_cost"/>
                                        <field name="overhead_cost"/>
                                        <field name="total_cost"/>
                                    </group>
                                    <group string="Profitability">
                                        <field name="gross_profit"/>
                                        <field name="net_profit"/>
                                        <field name="gross_margin_percent" string="Gross Margin %"/>
                                        <field name="net_margin_percent" string="Net Margin %"/>
                                        <field name="roi_percent" string="ROI %"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_tapis_profitability_analysis_search" model="ir.ui.view">
            <field name="name">tapis.profitability.analysis.search</field>
            <field name="model">tapis.profitability.analysis</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="analysis_type"/>
                    <field name="product_id"/>
                    <field name="customer_id"/>
                    <field name="state"/>
                    <filter name="calculated" string="Calculated"
                        domain="[('state', '=', 'calculated')]"/>
                    <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_type" string="Type"
                            context="{'group_by': 'analysis_type'}"/>
                        <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action -->
        <record id="action_profitability_analysis" model="ir.actions.act_window">
            <field name="name">Profitability Analysis</field>
            <field name="res_model">tapis.profitability.analysis</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_tapis_profitability_analysis_search"/>
        </record>

    </data>
</odoo>
