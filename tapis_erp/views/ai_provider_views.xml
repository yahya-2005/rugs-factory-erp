<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_tree" model="ir.ui.view">
        <field name="name">tapis.ai.provider.tree</field>
        <field name="model">tapis.ai.provider</field>
        <field name="arch" type="xml">
            <tree string="AI Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="model_name"/>
                <field name="active"/>
                <field name="is_default" widget="boolean_fair"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">tapis.ai.provider.form</field>
        <field name="model">tapis.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_type"/>
                            <field name="active"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="api_key" password="True"/>
                            <field name="base_url"/>
                            <field name="model_name"/>
                            <field name="timeout_seconds"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_provider_search" model="ir.ui.view">
        <field name="name">tapis.ai.provider.search</field>
        <field name="model">tapis.ai.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider_type"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="default" string="Default" domain="[('is_default','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">tapis.ai.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ai_provider_search"/>
    </record>

    <menuitem id="menu_ai_provider"
        name="AI Providers"
        parent="tapis_erp.menu_configuration_root"
        action="action_ai_provider"
        sequence="5"/>
</odoo>
