<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_webhook_subscription_tree" model="ir.ui.view">
        <field name="name">tapis.webhook.subscription.tree</field>
        <field name="model">tapis.webhook.subscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="event_code"/>
                <field name="target_url"/>
                <field name="active"/>
                <field name="total_sent"/>
                <field name="success_count"/>
            </tree>
        </field>
    </record>
    <record id="view_webhook_subscription_form" model="ir.ui.view">
        <field name="name">tapis.webhook.subscription.form</field>
        <field name="model">tapis.webhook.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="event_code"/>
                            <field name="target_url"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="secret_key"/>
                            <field name="retry_policy"/>
                            <field name="auth_headers"/>
                        </group>
                    </group>
                    <group string="Statistics">
                        <group>
                            <field name="total_sent"/>
                            <field name="success_count"/>
                            <field name="failure_count"/>
                        </group>
                        <group>
                            <field name="last_sent"/>
                            <field name="last_status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tapis_webhook_subscription" model="ir.actions.act_window">
        <field name="name">Webhook Subscriptions</field>
        <field name="res_model">tapis.webhook.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
