<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kpi_snapshot_tree" model="ir.ui.view">
        <field name="name">tapis.kpi.snapshot.tree</field>
        <field name="model">tapis.kpi.snapshot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="snapshot_datetime"/>
                <field name="total_sales" sum="Total"/>
                <field name="monthly_sales"/>
                <field name="active_productions"/>
                <field name="delayed_productions"/>
                <field name="on_time_delivery_rate" widget="progressbar"/>
                <field name="inventory_value"/>
                <field name="net_profit"/>
            </tree>
        </field>
    </record>
    <record id="view_kpi_snapshot_form" model="ir.ui.view">
        <field name="name">tapis.kpi.snapshot.form</field>
        <field name="model">tapis.kpi.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_snapshot" type="object" string="Generate Snapshot" class="btn-primary"/>
                    <button name="action_export_excel" type="object" string="Export Excel" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>KPI Snapshot</h1></div>
                    <group>
                        <field name="snapshot_datetime"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Sales">
                            <group>
                                <field name="total_sales"/>
                                <field name="monthly_sales"/>
                                <field name="open_quotes"/>
                                <field name="overdue_invoices"/>
                            </group>
                        </page>
                        <page string="Production">
                            <group>
                                <field name="active_productions"/>
                                <field name="delayed_productions"/>
                                <field name="on_time_delivery_rate" widget="progressbar"/>
                            </group>
                        </page>
                        <page string="Inventory">
                            <group>
                                <field name="inventory_value"/>
                                <field name="low_stock_products"/>
                                <field name="stock_turnover"/>
                            </group>
                        </page>
                        <page string="Financial">
                            <group>
                                <field name="gross_profit"/>
                                <field name="net_profit"/>
                                <field name="average_margin" widget="progressbar"/>
                            </group>
                        </page>
                        <page string="Customers">
                            <group>
                                <field name="active_customers"/>
                                <field name="open_tickets"/>
                                <field name="customer_satisfaction" widget="progressbar"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tapis_kpi_snapshot" model="ir.actions.act_window">
        <field name="name">KPI Snapshots</field>
        <field name="res_model">tapis.kpi.snapshot</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
