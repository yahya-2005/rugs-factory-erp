<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tapis_approval_rule_tree" model="ir.ui.view">
            <field name="name">tapis.approval.rule.tree</field>
            <field name="model">tapis.approval.rule</field>
            <field name="arch" type="xml">
                <tree string="Approval Rules" decoration-info="active == True" decoration-muted="active == False">
                    <field name="sequence" widget="handle"/>
                    <field name="category_id"/>
                    <field name="name"/>
                    <field name="min_amount"/>
                    <field name="max_amount"/>
                    <field name="required_approvals"/>
                    <field name="is_sequential"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_tapis_approval_rule_form" model="ir.ui.view">
            <field name="name">tapis.approval.rule.form</field>
            <field name="model">tapis.approval.rule</field>
            <field name="arch" type="xml">
                <form string="Approval Rule">
                    <sheet>
                        <group>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="required_approvals"/>
                            <field name="is_sequential"/>
                        </group>
                        <group string="Amount Conditions">
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                        </group>
                        <group string="Cost Center">
                            <field name="cost_center_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Approvers">
                            <field name="approver_user_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_tapis_approval_rule" model="ir.actions.act_window">
            <field name="name">Approval Rules</field>
            <field name="res_model">tapis.approval.rule</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
