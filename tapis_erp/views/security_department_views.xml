<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_department_tree" model="ir.ui.view">
        <field name="name">tapis.security.department.tree</field>
        <field name="model">tapis.security.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_user_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_security_department_form" model="ir.ui.view">
        <field name="name">tapis.security.department.form</field>
        <field name="model">tapis.security.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="manager_user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_security_department_search" model="ir.ui.view">
        <field name="name">tapis.security.department.search</field>
        <field name="model">tapis.security.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_user_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_tapis_security_department" model="ir.actions.act_window">
        <field name="name">Security Departments</field>
        <field name="res_model">tapis.security.department</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_department_search"/>
    </record>
</odoo>
