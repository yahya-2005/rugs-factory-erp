<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tapis_dw_config_form" model="ir.ui.view">
        <field name="name">tapis.dw.config.form</field>
        <field name="model">tapis.dw.config</field>
        <field name="arch" type="xml">
            <form string="Data Warehouse Configuration">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused"/>
                    <button name="action_run_etl" string="Run ETL" type="object"
                            groups="tapis_erp.group_bi_data_engineer"
                            class="btn-primary" states="active"/>
                    <button name="action_rebuild_warehouse" string="Rebuild Warehouse" type="object"
                            groups="tapis_erp.group_bi_data_engineer"
                            confirm="This will delete all warehouse data and reload. Continue?"
                            class="btn-danger" states="active"/>
                    <button name="action_export_csv" string="Export CSV" type="object"
                            groups="tapis_erp.group_bi_analyst"/>
                    <button name="action_export_excel" string="Export Excel" type="object"
                            groups="tapis_erp.group_bi_analyst"/>
                </header>
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Extraction Settings">
                            <field name="incremental_load"/>
                            <field name="last_etl_datetime"/>
                            <field name="retention_months"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <group string="Scheduling">
                                <field name="auto_run"/>
                                <field name="cron_interval_number"/>
                                <field name="cron_interval_type"/>
                            </group>
                            <group string="Warehouse Status">
                                <field name="rows_in_warehouse"/>
                                <field name="largest_fact_table"/>
                                <field name="data_freshness"/>
                                <field name="last_run_id"/>
                                <field name="last_run_status"/>
                                <field name="last_run_duration"/>
                            </group>
                        </page>
                        <page string="ETL History">
                            <field name="etl_run_ids" nolabel="1">
                                <tree>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="duration_seconds" widget="float_time"/>
                                    <field name="status" decoration-danger="status == 'failed'"
                                            decoration-success="status == 'success'"
                                            decoration-warning="status == 'partial'"/>
                                    <field name="rows_extracted"/>
                                    <field name="rows_transformed"/>
                                    <field name="rows_loaded"/>
                                    <field name="error_message" optional="show"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Metrics">
                        </page>
                        <page string="Notes">
                            <field name="name" invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tapis_dw_config_tree" model="ir.ui.view">
        <field name="name">tapis.dw.config.tree</field>
        <field name="model">tapis.dw.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="state" widget="badge"/>
                <field name="data_freshness"/>
                <field name="etl_run_count"/>
                <field name="rows_in_warehouse"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_tapis_dw_config_search" model="ir.ui.view">
        <field name="name">tapis.dw.config.search</field>
        <field name="model">tapis.dw.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Paused" name="paused" domain="[('state','=','paused')]"/>
            </search>
        </field>
    </record>

    <record id="action_tapis_dw_config" model="ir.actions.act_window">
        <field name="name">Warehouse Configuration</field>
        <field name="res_model">tapis.dw.config</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_tapis_dw_config_search"/>
        <field name="help" type="html">
            <p>Configure your data warehouse and ETL pipeline here.</p>
            <p>Set up extraction settings, scheduling, and run the ETL process.</p>
        </field>
    </record>

