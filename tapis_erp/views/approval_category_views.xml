<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tapis_approval_category_tree" model="ir.ui.view">
            <field name="name">tapis.approval.category.tree</field>
            <field name="model">tapis.approval.category</field>
            <field name="arch" type="xml">
                <tree string="Approval Categories" decoration-info="active == True" decoration-muted="active == False">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="model_name"/>
                    <field name="active"/>
                    <field name="rule_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="view_tapis_approval_category_form" model="ir.ui.view">
            <field name="name">tapis.approval.category.form</field>
            <field name="model">tapis.approval.category</field>
            <field name="arch" type="xml">
                <form string="Approval Category">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="model_name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="auto_apply"/>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Approval Rules">
                                <field name="rule_ids">
                                    <tree editable="bottom">
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="approver_user_ids" widget="many2many_tags"/>
                                        <field name="required_approvals"/>
                                        <field name="is_sequential"/>
                                        <field name="min_amount"/>
                                        <field name="max_amount"/>
                                        <field name="cost_center_id"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_tapis_approval_category_search" model="ir.ui.view">
            <field name="name">tapis.approval.category.search</field>
            <field name="model">tapis.approval.category</field>
            <field name="arch" type="xml">
                <search string="Search Approval Categories">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="model_name"/>
                    <filter name="active" string="Active" domain="[('active','=',True)]"/>
                </search>
            </field>
        </record>

        <record id="action_tapis_approval_category" model="ir.actions.act_window">
            <field name="name">Approval Categories</field>
            <field name="res_model">tapis.approval.category</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_tapis_approval_category_search"/>
        </record>
    </data>
</odoo>
