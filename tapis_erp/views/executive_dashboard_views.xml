<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_executive_dashboard" model="ir.ui.view">
        <field name="name">tapis.executive.dashboard</field>
        <field name="model">tapis.kpi.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_snapshot" type="object" string="Refresh Dashboard" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Executive Dashboard</h1></div>
                    <group string="Sales KPIs">
                        <group>
                            <field name="total_sales" class="oe_stat_button"/>
                            <field name="monthly_sales"/>
                            <field name="open_quotes"/>
                        </group>
                        <group>
                            <field name="overdue_invoices" decoration-danger="overdue_invoices&gt;0"/>
                            <field name="gross_profit"/>
                            <field name="net_profit"/>
                        </group>
                    </group>
                    <group string="Production KPIs">
                        <group>
                            <field name="active_productions"/>
                            <field name="delayed_productions" decoration-danger="delayed_productions&gt;0"/>
                        </group>
                        <group>
                            <field name="on_time_delivery_rate" widget="progressbar"/>
                            <field name="average_margin" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Inventory &amp; Customers">
                        <group>
                            <field name="inventory_value"/>
                            <field name="low_stock_products" decoration-danger="low_stock_products&gt;0"/>
                        </group>
                        <group>
                            <field name="active_customers"/>
                            <field name="open_tickets"/>
                            <field name="customer_satisfaction" widget="progressbar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tapis_executive_dashboard" model="ir.actions.act_window">
        <field name="name">Executive Dashboard</field>
        <field name="res_model">tapis.kpi.snapshot</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_executive_dashboard"/>
        <field name="help" type="html">
            <p>Executive dashboard showing real-time KPIs. Click "Refresh Dashboard" to update.</p>
        </field>
    </record>
</odoo>
