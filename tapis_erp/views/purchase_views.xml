<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE VIEW -->
        <record id="view_purchase_tree" model="ir.ui.view">
            <field name="name">tapis.purchase.tree</field>
            <field name="model">tapis.purchase</field>
            <field name="arch" type="xml">
                <tree string="Purchase Orders"
                    decoration-warning="state == 'pending_approval'"
                    decoration-info="state == 'approved'"
                    decoration-success="state == 'received'"
                    decoration-danger="state == 'cancelled'">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="total_price" sum="Total Purchases"/>
                    <field name="delivery_delay_days"/>
                    <field name="expected_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_purchase_form" model="ir.ui.view">
            <field name="name">tapis.purchase.form</field>
            <field name="model">tapis.purchase</field>
            <field name="arch" type="xml">
                <form string="Purchase Order">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" states="draft" class="btn-primary"/>
                        <button name="action_approve" type="object" string="Approve" states="pending_approval" class="btn-success"/>
                        <button name="action_reject" type="object" string="Reject" states="pending_approval" class="btn-warning"/>
                        <button name="action_receive" type="object" string="Receive" states="approved" class="btn-success"/>
                        <button name="action_cancel" type="object" string="Cancel" states="draft,pending_approval,approved" class="btn-danger"/>
                        <button name="action_request_approval" type="object" string="Request Approval" states="draft" class="btn-primary" confirm="Submit this purchase for approval?"/>
                        <button name="action_view_documents" type="object" string="Documents" class="btn-secondary"/>
                        <button name="%(action_report_purchase)d"
                                type="action"
                                string="Print Purchase Report"
                                class="btn-secondary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved,received"/>
                    </header>
                    <sheet>
                        <field name="approval_request_id" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_approval_request" type="object" class="oe_stat_button" icon="fa-check-circle"
                                attrs="{'invisible': [('approval_request_id', '=', False)]}">
                                <div class="o_stat_info">
                                    <field name="approval_state" widget="statinfo"/>
                                    <span class="o_stat_text">Approval</span>
                                </div>
                            </button>
                            <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                                <div class="o_stat_info">
                                    <field name="document_count" widget="statinfo"/>
                                    <span class="o_stat_text">Documents</span>
                                </div>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <field name="name"/>
                                    <field name="supplier_id"/>
                                    <field name="product_id"/>
                                    <field name="warehouse_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="pricelist_price" readonly="1"/>
                                    <field name="total_price" readonly="1"/>
                                    <field name="approval_threshold"/>
                                    <field name="expected_date"/>
                                    <field name="received_date"/>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_purchase_search" model="ir.ui.view">
            <field name="name">tapis.purchase.search</field>
            <field name="model">tapis.purchase</field>
            <field name="arch" type="xml">
                <search string="Search Purchase Orders">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                    <filter name="pending_approval" string="Pending Approval" domain="[('state','=','pending_approval')]"/>
                    <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                    <filter name="received" string="Received" domain="[('state','=','received')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_supplier" string="Supplier" context="{'group_by':'supplier_id'}"/>
                        <filter name="group_by_state" string="State" context="{'group_by':'state'}"/>
                        <filter name="group_by_product" string="Product" context="{'group_by':'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_purchase" model="ir.actions.act_window">
            <field name="name">Purchases</field>
            <field name="res_model">tapis.purchase</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_purchase_search"/>
        </record>

    </data>
</odoo>
