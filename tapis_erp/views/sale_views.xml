<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE VIEW -->
        <record id="view_sale_tree" model="ir.ui.view">
            <field name="name">tapis.sale.tree</field>
            <field name="model">tapis.sale</field>
            <field name="arch" type="xml">
                <tree string="Sales"
                    decoration-success="state == 'delivered'"
                    decoration-warning="state == 'confirmed'"
                    decoration-danger="payment_status == 'unpaid' and state == 'delivered'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="total_price" sum="Total Revenue"/>
                    <field name="amount_paid"/>
                    <field name="balance_due"/>
                    <field name="payment_status"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_sale_form" model="ir.ui.view">
            <field name="name">tapis.sale.form</field>
            <field name="model">tapis.sale</field>
            <field name="arch" type="xml">
                <form string="Sale Order">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" states="draft" class="btn-primary"/>
                        <button name="action_deliver" type="object" string="Deliver" states="confirmed" class="btn-success"/>
                        <button name="action_create_invoice" type="object" string="Create Invoice" states="delivered" class="btn-primary"
                                attrs="{'invisible': [('invoice_count', '&gt;', 0)]}"/>
                        <button name="action_view_documents" type="object" string="Documents" class="btn-secondary"/>
                        <button name="%(action_report_sale)d"
                                type="action"
                                string="Print Invoice"
                                class="btn-secondary"/><field name="state" widget="statusbar" statusbar_visible="draft,confirmed,delivered"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoices" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    context="{'search_default_filter_active': 1}">
                                <div class="o_stat_info">
                                    <field name="invoice_count" widget="statinfo"/>
                                    <span class="o_stat_text">Invoices</span>
                                </div>
                            </button>
                        </div>
                        <notebook>
                            <page string="Sale Order">
                                <group>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="partner_id"/>
                                    <field name="order_date"/>
                                    <field name="product_id"/>
                                    <field name="warehouse_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="total_price" readonly="1"/>
                                </group>
                            </page>
                            <page string="Payment &amp; Profitability">
                                <group>
                                    <field name="amount_paid"/>
                                    <field name="balance_due"/>
                                    <field name="payment_status"/>
                                </group>
                                <group>
                                    <field name="cost_amount"/>
                                    <field name="profit_amount"/>
                                    <field name="margin_percent"/>
                                </group>
                            </page>
                            <page string="Invoices">
                                <field name="invoice_ids" readonly="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="invoice_date"/>
                                        <field name="due_date"/>
                                        <field name="amount_total"/>
                                        <field name="amount_due"/>
                                        <field name="payment_status"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                         <field name="activity_ids"/>
                        <field name="message_ids"/>
</div>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_sale_search" model="ir.ui.view">
            <field name="name">tapis.sale.search</field>
            <field name="model">tapis.sale</field>
            <field name="arch" type="xml">
                <search string="Sales">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="product_id"/>
                    <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                    <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                    <filter name="delivered" string="Delivered" domain="[('state','=','delivered')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_customer" string="Customer" context="{'group_by':'customer_id'}"/>
                        <filter name="group_by_product" string="Product" context="{'group_by':'product_id'}"/>
                        <filter name="group_by_state" string="State" context="{'group_by':'state'}"/>
                        <filter name="group_by_payment" string="Payment Status" context="{'group_by':'payment_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_sale" model="ir.actions.act_window">
            <field name="name">Sales</field>
            <field name="res_model">tapis.sale</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sale_search"/>
        </record>

    </data>
</odoo>
