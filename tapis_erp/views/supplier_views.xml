<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE VIEW -->
        <record id="view_supplier_tree" model="ir.ui.view">
            <field name="name">tapis.supplier.tree</field>
            <field name="model">tapis.supplier</field>
            <field name="arch" type="xml">
                <tree string="Suppliers">
                    <field name="name"/>
                    <field name="contact_person"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_supplier_form" model="ir.ui.view">
            <field name="name">tapis.supplier.form</field>
            <field name="model">tapis.supplier</field>
            <field name="arch" type="xml">
                <form string="Supplier">
                    <header>
                        <button name="action_view_purchases" type="object" class="oe_stat_button" icon="fa-truck">
                            <div class="o_stat_info">
                                <field name="purchase_count" widget="statinfo"/>
                                <span class="o_stat_text">Purchases</span>
                            </div>
                        </button>
                        <button name="action_view_pricelists" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <field name="pricelist_count" widget="statinfo"/>
                                <span class="o_stat_text">Pricelists</span>
                            </div>
                        </button>
                        <button name="action_open_scorecard" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <span class="o_stat_text">Scorecard</span>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                            <div class="o_stat_info">
                                <field name="document_count" widget="statinfo"/>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                    </header>
                    <sheet>
                        <div class="row">
                            <div class="col-xs-4">
                                <group>
                                    <field name="overall_score" widget="statinfo"/>
                                </group>
                            </div>
                            <div class="col-xs-4">
                                <group>
                                    <field name="quality_score"/>
                                </group>
                            </div>
                            <div class="col-xs-4">
                                <group>
                                    <field name="on_time_delivery_rate"/>
                                </group>
                            </div>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <field name="name"/>
                                    <field name="contact_person"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="address"/>
                                </group>
                            </page>
                            <page string="Pricelists">
                                <field name="pricelist_ids" readonly="1">
                                    <tree>
                                        <field name="product_id"/>
                                        <field name="raw_material_id"/>
                                        <field name="price"/>
                                        <field name="min_quantity"/>
                                        <field name="lead_time_days"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Purchase Orders">
                                <field name="purchase_ids" readonly="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="total_price"/>
                                        <field name="delivery_delay_days"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_supplier_search" model="ir.ui.view">
            <field name="name">tapis.supplier.search</field>
            <field name="model">tapis.supplier</field>
            <field name="arch" type="xml">
                <search string="Search Suppliers">
                    <field name="name"/>
                    <field name="contact_person"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_supplier" model="ir.actions.act_window">
            <field name="name">Suppliers</field>
            <field name="res_model">tapis.supplier</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_supplier_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
        </record>

    </data>
</odoo>
