<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_raw_material_tree" model="ir.ui.view">
            <field name="name">tapis.raw.material.tree</field>
            <field name="model">tapis.raw.material</field>
            <field name="arch" type="xml">
                <tree string="Raw Materials"
                    decoration-danger="stock_qty &lt;= 0"
                    decoration-warning="stock_qty &gt; 0 and stock_qty &lt; 10">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="uom"/>
                    <field name="stock_qty"/>
                    <field name="cost_per_unit"/>
                    <field name="inventory_value" sum="Total Value"/>
                    <field name="supplier_id"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_raw_material_form" model="ir.ui.view">
            <field name="name">tapis.raw.material.form</field>
            <field name="model">tapis.raw.material</field>
            <field name="arch" type="xml">
                <form string="Raw Material">
                    <header>
                        <button name="action_view_bom_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_text">BOM Lines</span>
                            </div>
                        </button>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="uom"/>
                            <field name="cost_per_unit"/>
                            <field name="stock_qty"/>
                            <field name="inventory_value"/>
                        </group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_raw_material_search" model="ir.ui.view">
            <field name="name">tapis.raw.material.search</field>
            <field name="model">tapis.raw.material</field>
            <field name="arch" type="xml">
                <search string="Search Raw Materials">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="supplier_id"/>
                    <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                </search>
            </field>
        </record>

        <record id="action_raw_material" model="ir.actions.act_window">
            <field name="name">Raw Materials</field>
            <field name="res_model">tapis.raw.material</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_raw_material_search"/>
        </record>
    </data>
</odoo>
