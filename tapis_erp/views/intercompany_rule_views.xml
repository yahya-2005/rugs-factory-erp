<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intercompany_rule_tree" model="ir.ui.view">
        <field name="name">tapis.intercompany.rule.tree</field>
        <field name="model">tapis.intercompany.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <field name="auto_create_purchase"/>
                <field name="auto_create_sale"/>
                <field name="auto_validate_documents"/>
                <field name="margin_percent" string="Margin (%)"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_intercompany_rule_form" model="ir.ui.view">
        <field name="name">tapis.intercompany.rule.form</field>
        <field name="model">tapis.intercompany.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="source_company_id" options="{'no_create': True}"/>
                            <field name="target_company_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="margin_percent" string="Intercompany Margin (%)"/>
                        </group>
                    </group>
                    <group string="Auto-Creation Rules">
                        <group>
                            <field name="auto_create_purchase"/>
                            <field name="auto_create_sale"/>
                        </group>
                        <group>
                            <field name="auto_validate_documents"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_intercompany_rule_search" model="ir.ui.view">
        <field name="name">tapis.intercompany.rule.search</field>
        <field name="model">tapis.intercompany.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_tapis_intercompany_rule" model="ir.actions.act_window">
        <field name="name">Intercompany Rules</field>
        <field name="res_model">tapis.intercompany.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_intercompany_rule_search"/>
    </record>
</odoo>
