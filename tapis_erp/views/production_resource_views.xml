<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_production_resource_tree" model="ir.ui.view">
            <field name="name">tapis.production.resource.tree</field>
            <field name="model">tapis.production.resource</field>
            <field name="arch" type="xml">
                <tree string="Production Resources">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="resource_type"/>
                    <field name="capacity_hours_per_day"/>
                    <field name="efficiency_percent"/>
                    <field name="supervisor_id"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_production_resource_form" model="ir.ui.view">
            <field name="name">tapis.production.resource.form</field>
            <field name="model">tapis.production.resource</field>
            <field name="arch" type="xml">
                <form string="Production Resource">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_tapis_production)d" type="action"
                                    class="oe_stat_button" icon="fa-industry">
                                <div class="o_stat_info">
                                    <field name="conflict_count" widget="statinfo"/>
                                    <span class="o_stat_text">Conflicts</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="resource_type"/>
                                <field name="capacity_hours_per_day"/>
                            </group>
                            <group>
                                <field name="efficiency_percent"/>
                                <field name="active"/>
                                <field name="supervisor_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Assignments">
                                <field name="production_ids" readonly="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="product_id"/>
                                        <field name="state"/>
                                        <field name="planned_start_date"/>
                                        <field name="planned_end_date"/>
                                        <field name="estimated_hours"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_production_resource_search" model="ir.ui.view">
            <field name="name">tapis.production.resource.search</field>
            <field name="model">tapis.production.resource</field>
            <field name="arch" type="xml">
                <search string="Search Resources">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="supervisor_id"/>
                    <filter name="active" string="Active" domain="[('active','=',True)]"/>
                    <filter name="loom" string="Looms" domain="[('resource_type','=','loom')]"/>
                    <filter name="weaving_team" string="Weaving Teams" domain="[('resource_type','=','weaving_team')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_type" string="Type" context="{'group_by':'resource_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_production_resource" model="ir.actions.act_window">
            <field name="name">Production Resources</field>
            <field name="res_model">tapis.production.resource</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_production_resource_search"/>
        </record>
    </data>
</odoo>
