<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE VIEW -->
        <record id="view_invoice_tree" model="ir.ui.view">
            <field name="name">tapis.invoice.tree</field>
            <field name="model">tapis.invoice</field>
            <field name="arch" type="xml">
                <tree string="Invoices"
                    decoration-danger="payment_status == 'unpaid' and state == 'posted'"
                    decoration-warning="payment_status == 'partial' and state == 'posted'"
                    decoration-success="payment_status == 'paid'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="invoice_date"/>
                    <field name="due_date"/>
                    <field name="amount_untaxed" sum="Total Untaxed"/>
                    <field name="tax_amount" sum="Total Tax"/>
                    <field name="amount_total" sum="Total Invoiced"/>
                    <field name="amount_paid" sum="Total Paid"/>
                    <field name="amount_due" sum="Total Due"/>
                    <field name="payment_status"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_invoice_form" model="ir.ui.view">
            <field name="name">tapis.invoice.form</field>
            <field name="model">tapis.invoice</field>
            <field name="arch" type="xml">
                <form string="Invoice">
                    <header>
                        <button name="action_post" type="object" string="Post" states="draft" class="btn-primary"/>
                        <button name="action_register_payment" type="object" string="Register Payment"
                                states="posted" class="btn-success"
                                attrs="{'invisible': [('amount_due', '&lt;=', 0)]}"/>
                        <button name="action_cancel" type="object" string="Cancel" states="draft,posted" class="btn-danger"/>
                        <button name="action_print_invoice" type="object" string="Print Invoice" class="btn-secondary"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,posted"
                               statusbar_colors='{"posted":"success","cancelled":"danger"}'>
                            <field name="payment_status" invisible="1"/>
                        </field>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_sale" type="object"
                                    class="oe_stat_button" icon="fa-shopping-cart">
                                <div class="o_stat_info">
                                    <field name="sale_id" widget="statinfo"/>
                                    <span class="o_stat_text">Sale Order</span>
                                </div>
                            </button>
                            <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                                <div class="o_stat_info">
                                    <field name="document_count" widget="statinfo"/>
                                    <span class="o_stat_text">Documents</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="customer_id"/>
                                <field name="invoice_date"/>
                                <field name="due_date"/>
                            </group>
                            <group>
                                <field name="amount_untaxed" string="Untaxed Amount (MAD)"/>
                                <field name="tax_rate"/>
                                <field name="tax_amount" string="Tax Amount (MAD)"/>
                                <field name="amount_total" string="Total (MAD)"/>
                            </group>
                            <group>
                                <field name="amount_paid" string="Paid (MAD)"/>
                                <field name="amount_due" string="Due (MAD)"/>
                                <field name="payment_status" widget="badge"
                                       decoration-success="payment_status == 'paid'"
                                       decoration-danger="payment_status == 'unpaid'"
                                       decoration-warning="payment_status == 'partial'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="note" nolabel="1"/>
                            </page>
                            <page string="Chatter">
                                <field name="message_follower_ids"/>
                                <field name="activity_ids"/>
                                <field name="message_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_invoice_search" model="ir.ui.view">
            <field name="name">tapis.invoice.search</field>
            <field name="model">tapis.invoice</field>
            <field name="arch" type="xml">
                <search string="Search Invoices">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="sale_id"/>
                    <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                    <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                    <filter name="unpaid" string="Unpaid" domain="[('payment_status','=','unpaid')]"/>
                    <filter name="partial" string="Partial" domain="[('payment_status','=','partial')]"/>
                    <filter name="paid" string="Paid" domain="[('payment_status','=','paid')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_customer" string="Customer" context="{'group_by':'customer_id'}"/>
                        <filter name="group_by_state" string="State" context="{'group_by':'state'}"/>
                        <filter name="group_by_payment" string="Payment Status" context="{'group_by':'payment_status'}"/>
                        <filter name="group_by_date" string="Invoice Date" context="{'group_by':'invoice_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_invoice" model="ir.actions.act_window">
            <field name="name">Invoices</field>
            <field name="res_model">tapis.invoice</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_invoice_search"/>
        </record>

        </data>
</odoo>
