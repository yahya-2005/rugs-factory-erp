<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE VIEW -->
        <record id="view_employee_tree" model="ir.ui.view">
            <field name="name">tapis.employee.tree</field>
            <field name="model">tapis.employee</field>
            <field name="arch" type="xml">
                <tree string="Employees">
                    <field name="name"/>
                    <field name="role"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="salary"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_employee_form" model="ir.ui.view">
            <field name="name">tapis.employee.form</field>
            <field name="model">tapis.employee</field>
            <field name="arch" type="xml">
                <form string="Employee">
                    <header>
                        <button name="action_view_productions" type="object" class="oe_stat_button" icon="fa-industry">
                            <div class="o_stat_info">
                                <field name="production_count" widget="statinfo"/>
                                <span class="o_stat_text">Productions</span>
                            </div>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                            <div class="o_stat_info">
                                <field name="document_count" widget="statinfo"/>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="salary"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_employee" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">tapis.employee</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
