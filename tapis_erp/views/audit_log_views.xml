<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE VIEW -->
        <record id="view_tapis_audit_log_tree" model="ir.ui.view">
            <field name="name">tapis.audit.log.tree</field>
            <field name="model">tapis.audit.log</field>
            <field name="arch" type="xml">
                <tree decoration-success="action_type == 'create'" decoration-info="action_type == 'write'" decoration-danger="action_type == 'unlink'">
                    <field name="action_date"/>
                    <field name="action_type" widget="badge"/>
                    <field name="user_id"/>
                    <field name="model_name"/>
                    <field name="record_name"/>
                    <field name="field_label"/>
                    <field name="old_value"/>
                    <field name="new_value"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_tapis_audit_log_form" model="ir.ui.view">
            <field name="name">tapis.audit.log.form</field>
            <field name="model">tapis.audit.log</field>
            <field name="arch" type="xml">
                <form string="Audit Log">
                    <sheet>
                        <group>
                            <group>
                                <field name="action_type" widget="badge"/>
                                <field name="action_date"/>
                                <field name="user_id"/>
                                <field name="employee_id"/>
                            </group>
                            <group>
                                <field name="model_name"/>
                                <field name="record_name"/>
                                <field name="record_id"/>
                            </group>
                        </group>
                        <group string="Change Details">
                            <group>
                                <field name="field_name"/>
                                <field name="field_label"/>
                            </group>
                            <group>
                                <field name="old_value" nolabel="1"/>
                            </group>
                            <group>
                                <field name="new_value" nolabel="1"/>
                            </group>
                        </group>
                        <group string="Technical Info" attrs="{'invisible': [('ip_address', '=', False)]}">
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                            <field name="module_name"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_tapis_audit_log_search" model="ir.ui.view">
            <field name="name">tapis.audit.log.search</field>
            <field name="model">tapis.audit.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="user_id"/>
                    <field name="model_name"/>
                    <field name="record_name"/>
                    <filter name="create" string="Created" domain="[('action_type', '=', 'create')]"/>
                    <filter name="write" string="Updated" domain="[('action_type', '=', 'write')]"/>
                    <filter name="unlink" string="Deleted" domain="[('action_type', '=', 'unlink')]"/>
                    <separator/>
                    <filter name="today" string="Today" domain="[('action_date', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter name="this_week" string="This Week" domain="[('action_date', '>=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter name="this_month" string="This Month" domain="[('action_date', '>=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                    <separator/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'action_date:date'}"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_tapis_audit_log" model="ir.actions.act_window">
            <field name="name">Audit Logs</field>
            <field name="res_model">tapis.audit.log</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_tapis_audit_log_search"/>
            <field name="help" type="html">
                <p>Full audit trail of all ERP changes. Track who changed what and when.</p>
            </field>
        </record>
    </data>
</odoo>
