<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_generate_date_dimension" model="ir.cron">
            <field name="name">DW: Generate Date Dimension</field>
            <field name="model_id" ref="model_tapis_dw_dim_date"/>
            <field name="state">code</field>
            <field name="code">model.generate_date_dimension(10)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
        </record>

        <record id="cron_etl_pipeline" model="ir.cron">
            <field name="name">DW: Run ETL Pipeline</field>
            <field name="model_id" ref="model_tapis_dw_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_etl()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
