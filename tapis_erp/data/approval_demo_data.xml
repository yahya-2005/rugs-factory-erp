<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Purchase Approval Category -->
        <record id="tapis_approval_category_purchase" model="tapis.approval.category">
            <field name="name">Purchase Approval</field>
            <field name="code">purchase</field>
            <field name="model_name">tapis.purchase</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
            <field name="auto_apply">True</field>
            <field name="description">Approval workflow for purchase orders exceeding thresholds</field>
        </record>

        <record id="tapis_approval_rule_purchase_1" model="tapis.approval.rule">
            <field name="category_id" ref="tapis_approval_category_purchase"/>
            <field name="name">Purchase ≥50,000 MAD</field>
            <field name="sequence">10</field>
            <field name="min_amount">50000</field>
            <field name="max_amount">0</field>
            <field name="approver_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="required_approvals">1</field>
            <field name="is_sequential">False</field>
            <field name="active">True</field>
        </record>

        <!-- Budget Approval Category -->
        <record id="tapis_approval_category_budget" model="tapis.approval.category">
            <field name="name">Budget Approval</field>
            <field name="code">budget</field>
            <field name="model_name">tapis.budget</field>
            <field name="active">True</field>
            <field name="sequence">20</field>
            <field name="auto_apply">True</field>
            <field name="description">Approval workflow for budgets</field>
        </record>

        <record id="tapis_approval_rule_budget_1" model="tapis.approval.rule">
            <field name="category_id" ref="tapis_approval_category_budget"/>
            <field name="name">Budget Approval</field>
            <field name="sequence">10</field>
            <field name="min_amount">0</field>
            <field name="max_amount">0</field>
            <field name="approver_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="required_approvals">1</field>
            <field name="is_sequential">False</field>
            <field name="active">True</field>
        </record>

        <!-- Document Approval Category -->
        <record id="tapis_approval_category_document" model="tapis.approval.category">
            <field name="name">Document Approval</field>
            <field name="code">document</field>
            <field name="model_name">tapis.document</field>
            <field name="active">True</field>
            <field name="sequence">30</field>
            <field name="auto_apply">True</field>
            <field name="description">Approval workflow for document publishing</field>
        </record>

        <record id="tapis_approval_rule_document_1" model="tapis.approval.rule">
            <field name="category_id" ref="tapis_approval_category_document"/>
            <field name="name">Document Approval</field>
            <field name="sequence">10</field>
            <field name="min_amount">0</field>
            <field name="max_amount">0</field>
            <field name="approver_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="required_approvals">1</field>
            <field name="is_sequential">False</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
