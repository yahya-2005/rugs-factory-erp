<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Demo Customer -->
        <record id="portal_demo_customer" model="tapis.customer">
            <field name="name">Portal Demo Customer</field>
            <field name="email">portal@demo.com</field>
            <field name="phone">+212 600-000000</field>
        </record>

        <!-- Demo Support Tickets -->
        <record id="ticket_demo_1" model="tapis.support.ticket">
            <field name="customer_id" ref="portal_demo_customer"/>
            <field name="subject">Request for design samples</field>
            <field name="category">sales</field>
            <field name="priority">medium</field>
            <field name="state">new</field>
            <field name="description">Customer requesting samples of traditional carpet designs for a hotel project.</field>
        </record>

        <record id="ticket_demo_2" model="tapis.support.ticket">
            <field name="customer_id" ref="portal_demo_customer"/>
            <field name="subject">Delivery delay inquiry</field>
            <field name="category">delivery</field>
            <field name="priority">high</field>
            <field name="state">in_progress</field>
            <field name="assigned_user_id" ref="base.user_admin"/>
            <field name="description">Customer asking about delayed delivery for order SALE-00001.</field>
        </record>

    </data>
</odoo>
