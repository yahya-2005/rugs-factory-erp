<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_design_modern_rug" model="tapis.design">
        <field name="name">Modern Rug MT41</field>
        <field name="length_cm" eval="430"/>
        <field name="width_cm" eval="300"/>
        <field name="density_kg_per_m2" eval="5.0"/>
    </record>

    <record id="demo_color_mt41" model="tapis.design.color.line">
        <field name="design_id" ref="demo_design_modern_rug"/>
        <field name="sequence" eval="10"/>
        <field name="color_code">MT41</field>
        <field name="color_name">Midnight Blue</field>
        <field name="percentage" eval="70"/>
    </record>

    <record id="demo_color_mt02" model="tapis.design.color.line">
        <field name="design_id" ref="demo_design_modern_rug"/>
        <field name="sequence" eval="20"/>
        <field name="color_code">MT02</field>
        <field name="color_name">Ivory White</field>
        <field name="percentage" eval="20"/>
    </record>

    <record id="demo_color_mt105" model="tapis.design.color.line">
        <field name="design_id" ref="demo_design_modern_rug"/>
        <field name="sequence" eval="30"/>
        <field name="color_code">MT105</field>
        <field name="color_name">Sahara Gold</field>
        <field name="percentage" eval="10"/>
    </record>
</odoo>
