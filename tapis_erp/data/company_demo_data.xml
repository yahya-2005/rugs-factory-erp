<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="company_tapis_maroc" model="res.company">
        <field name="name">Tapis Maroc SARL</field>
        <field name="street">123 Avenue Hassan II</field>
        <field name="city">Casablanca</field>
        <field name="country_id" ref="base.ma"/>
        <field name="phone">+212 522 123 456</field>
        <field name="email">info@tapismaroc.ma</field>
    </record>

    <record id="company_tapis_export" model="res.company">
        <field name="name">Tapis Export Europe GmbH</field>
        <field name="street">45 Musterstrasse</field>
        <field name="city">Berlin</field>
        <field name="country_id" ref="base.de"/>
        <field name="phone">+49 30 1234 5678</field>
        <field name="email">info@tapisexport.eu</field>
    </record>

    <record id="profile_tapis_maroc" model="tapis.company.profile">
        <field name="company_id" ref="company_tapis_maroc"/>
        <field name="legal_name">Tapis Maroc SARL</field>
        <field name="trade_name">Tapis Maroc</field>
        <field name="tax_id">MA12345678</field>
        <field name="registration_number">RC 12345 Casablanca</field>
        <field name="industry">Carpet Manufacturing</field>
        <field name="phone">+212 522 123 456</field>
        <field name="email">info@tapismaroc.ma</field>
        <field name="currency_id" ref="base.MAD"/>
        <field name="fiscal_year_start_month" eval="1"/>
    </record>

    <record id="profile_tapis_export" model="tapis.company.profile">
        <field name="company_id" ref="company_tapis_export"/>
        <field name="legal_name">Tapis Export Europe GmbH</field>
        <field name="trade_name">Tapis Export</field>
        <field name="tax_id">DE98765432</field>
        <field name="registration_number">HRB 54321 Berlin</field>
        <field name="industry">Carpet Wholesale</field>
        <field name="phone">+49 30 1234 5678</field>
        <field name="email">info@tapisexport.eu</field>
        <field name="currency_id" ref="base.EUR"/>
        <field name="fiscal_year_start_month" eval="1"/>
    </record>

    <record id="intercompany_tapis_rule" model="tapis.intercompany.rule">
        <field name="source_company_id" ref="company_tapis_maroc"/>
        <field name="target_company_id" ref="company_tapis_export"/>
        <field name="auto_create_purchase" eval="True"/>
        <field name="auto_create_sale" eval="True"/>
        <field name="margin_percent" eval="10.0"/>
    </record>
</odoo>
