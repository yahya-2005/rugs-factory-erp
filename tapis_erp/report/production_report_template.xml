<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_production_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-xs-6">
                                <strong>WORK ORDER</strong>
                                <br/>
                                <span>Reference: </span><span t-field="o.name"/>
                            </div>
                            <div class="col-xs-6 text-right">
                                <strong>Tapis Morocco</strong>
                                <br/>
                                <span>Marrakech, Morocco</span>
                            </div>
                        </div>
                        <hr/>
                        <table class="table table-bordered">
                            <tr>
                                <td><strong>Product</strong></td>
                                <td><span t-field="o.product_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Design</strong></td>
                                <td><span t-field="o.design_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Quantity</strong></td>
                                <td><span t-field="o.quantity"/></td>
                            </tr>
                            <tr>
                                <td><strong>Status</strong></td>
                                <td><span t-field="o.state"/></td>
                            </tr>
                        </table>
                        <br/>
                        <div t-if="o.note">
                            <strong>Notes:</strong>
                            <br/>
                            <span t-field="o.note"/>
                        </div>
                        <hr/>
                        <p class="text-center">Tapis ERP - Production Department</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
