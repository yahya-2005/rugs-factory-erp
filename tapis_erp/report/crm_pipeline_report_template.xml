<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="crm_pipeline_report_template">
    <t t-call="web.html_container">
        <t t-call="web.internal_layout">
            <div class="page">
                <h2>Pipeline Summary</h2>
                <p>Generated: <t t-esc="context_timestamp(datetime.now()).strftime('%Y-%m-%d %H:%M')"/></p>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Opportunity</th>
                            <th>Contact</th>
                            <th>Stage</th>
                            <th>Salesperson</th>
                            <th>Expected Revenue</th>
                            <th>Probability</th>
                            <th>Weighted Revenue</th>
                            <th>Closing</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="doc">
                            <td><t t-esc="doc.code"/></td>
                            <td><t t-esc="doc.name"/></td>
                            <td><t t-esc="doc.contact_name or ''"/></td>
                            <td><t t-esc="doc.stage_id.name or ''"/></td>
                            <td><t t-esc="doc.salesperson_id.name or ''"/></td>
                            <td><t t-esc="doc.expected_revenue"/> MAD</td>
                            <td><t t-esc="doc.probability"/>%</td>
                            <td><t t-esc="doc.weighted_revenue"/> MAD</td>
                            <td><t t-esc="doc.expected_closing_date or ''"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </t>
</template>
</odoo>
