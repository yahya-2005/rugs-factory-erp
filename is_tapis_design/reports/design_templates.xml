<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_design_technical_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2>Design Technical Sheet</h2>
                        <table class="table table-bordered">
                            <tr>
                                <td width="50%">
                                    <p><strong>Design:</strong> <span t-field="doc.name"/></p>
                                    <p><strong>Code:</strong> <span t-field="doc.code"/></p>
                                    <p><strong>Dimensions:</strong>
                                        <span t-field="doc.length_cm"/> × <span t-field="doc.width_cm"/> cm</p>
                                    <p><strong>Surface:</strong> <span t-field="doc.surface_m2"/> m²</p>
                                    <p><strong>Weight Factor:</strong> <span t-field="doc.weight_factor"/> kg/m²</p>
                                    <p><strong>Estimated Weight:</strong> <span t-field="doc.estimated_weight_kg"/> kg</p>
                                    <p><strong>Status:</strong> <span t-field="doc.state"/></p>
                                </td>
                                <td width="50%" class="text-center">
                                    <span t-raw="doc.image_html"/>
                                </td>
                            </tr>
                        </table>
                        <h3>Color Composition</h3>
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Code</th>
                                    <th>Color Name</th>
                                    <th class="text-right">Percentage (%)</th>
                                    <th class="text-right">Est. Weight (kg)</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.color_line_ids" t-as="line">
                                    <td><span t-esc="line.sequence or line.id"/></td>
                                    <td><span t-field="line.color_code"/></td>
                                    <td><span t-field="line.color_name"/></td>
                                    <td class="text-right"><span t-esc="line.percentage"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line.estimated_weight_kg"/></td>
                                    <td><span t-esc="line.qty_available"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="font-weight:bold">
                                    <td colspan="3" class="text-right">Total</td>
                                    <td class="text-right"><span t-esc="'%.2f' % doc.total_percentage"/>%</td>
                                    <td class="text-right"><span t-esc="'%.2f' % doc.total_weight_allocated_kg"/></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p t-if="doc.ai_analysis_status == 'completed'">
                            <strong>AI Analysis:</strong> <span t-field="doc.ai_sequence_detected"/>
                            <em>(<span t-field="doc.ai_last_analysis_date"/>)</em>
                        </p>
                        <p><em>Generated on <span t-esc="time.strftime('%Y-%m-%d')"/></em></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

