<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wool_color_tree" model="ir.ui.view">
        <field name="name">wool.color.tree</field>
        <field name="model">wool.color</field>
        <field name="arch" type="xml">
            <tree decoration-danger="qty_on_hand &lt; reorder_point" decoration-warning="qty_on_hand &lt; minimum_stock">
                <field name="code"/>
                <field name="name"/>
                <field name="color_hex" widget="color"/>
                <field name="qty_on_hand"/>
                <field name="qty_reserved"/>
                <field name="qty_available"/>
                <field name="reorder_point"/>
                <field name="minimum_stock" optional="show"/>
                <field name="unit_cost"/>
                <field name="inventory_value"/>
                <field name="supplier_id"/>
            </tree>
        </field>
    </record>

    <record id="view_wool_color_form" model="ir.ui.view">
        <field name="name">wool.color.form</field>
        <field name="model">wool.color</field>
        <field name="arch" type="xml">
            <form string="Wool Color">
                <header>
                    <button name="action_open_moves" type="object" string="Stock Moves" class="btn-secondary"/>
                    <button name="action_adjust_stock" type="object" string="Adjust Stock" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-truck" name="action_open_moves" type="object">
                            <div class="o_stat_info">
                                <field name="move_count" widget="statinfo"/>
                                <span class="o_stat_text">Moves</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="1"/>
                            <field name="name" required="1"/>
                            <field name="display_name_full"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="color_hex" widget="color"/>
                            <field name="tag_color" widget="color_picker"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock">
                            <group>
                                <group>
                                    <field name="qty_on_hand"/>
                                    <field name="qty_reserved"/>
                                    <field name="qty_available"/>
                                </group>
                                <group>
                                    <field name="reorder_point"/>
                                    <field name="minimum_stock"/>
                                    <field name="maximum_stock"/>
                                </group>
                            </group>
                        </page>
                        <page string="Valuation">
                            <group>
                                <field name="unit_cost"/>
                                <field name="inventory_value"/>
                            </group>
                        </page>
                        <page string="Supplier">
                            <group>
                                <field name="supplier_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wool_color_search" model="ir.ui.view">
        <field name="name">wool.color.search</field>
        <field name="model">wool.color</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="supplier_id"/>
                <filter string="Low Stock" name="low_stock" domain="[('qty_on_hand','&lt;','reorder_point')]"/>
                <filter string="Available" name="available" domain="[('active','=',True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Supplier" name="group_supplier" context="{'group_by':'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wool_color_pivot" model="ir.ui.view">
        <field name="name">wool.color.pivot</field>
        <field name="model">wool.color</field>
        <field name="arch" type="xml">
            <pivot string="Wool Stock Analysis">
                <field name="qty_on_hand" type="measure"/>
                <field name="qty_available" type="measure"/>
                <field name="inventory_value" type="measure"/>
                <field name="reorder_point" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_wool_color_graph" model="ir.ui.view">
        <field name="name">wool.color.graph</field>
        <field name="model">wool.color</field>
        <field name="arch" type="xml">
            <graph string="Wool Stock Graph">
                <field name="qty_on_hand" type="measure"/>
                <field name="qty_available" type="measure"/>
                <field name="inventory_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_wool_color" model="ir.actions.act_window">
        <field name="name">Wool Colors</field>
        <field name="res_model">wool.color</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_wool_color_search"/>
    </record>
</odoo>
