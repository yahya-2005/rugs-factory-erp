<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wool_stock_move_tree" model="ir.ui.view">
        <field name="name">wool.stock.move.tree</field>
        <field name="model">wool.stock.move</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="wool_color_id"/>
                <field name="move_type" widget="badge"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_value"/>
                <field name="reference"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_wool_stock_move_form" model="ir.ui.view">
        <field name="name">wool.stock.move.form</field>
        <field name="model">wool.stock.move</field>
        <field name="arch" type="xml">
            <form string="Stock Move">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            states="draft"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"
                            states="draft"/>
                    <button name="action_draft" type="object" string="Reset to Draft" class="btn-secondary"
                            states="cancelled"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="wool_color_id" required="1"/>
                        </group>
                        <group>
                            <field name="move_type" required="1"/>
                            <field name="quantity" required="1"/>
                            <field name="unit_cost"/>
                            <field name="total_value"/>
                        </group>
                    </group>
                    <group>
                        <field name="reference"/>
                        <field name="source_document"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wool_stock_move_search" model="ir.ui.view">
        <field name="name">wool.stock.move.search</field>
        <field name="model">wool.stock.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="wool_color_id"/>
                <field name="reference"/>
                <filter string="Incoming" name="incoming" domain="[('move_type','=','in')]"/>
                <filter string="Outgoing" name="outgoing" domain="[('move_type','=','out')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by':'move_type'}"/>
                    <filter string="Color" name="group_color" context="{'group_by':'wool_color_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wool_stock_move_pivot" model="ir.ui.view">
        <field name="name">wool.stock.move.pivot</field>
        <field name="model">wool.stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Movement Analysis">
                <field name="quantity" type="measure"/>
                <field name="total_value" type="measure"/>
                <field name="move_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_wool_stock_move" model="ir.actions.act_window">
        <field name="name">Stock Movements</field>
        <field name="res_model">wool.stock.move</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_wool_stock_move_search"/>
    </record>
</odoo>
